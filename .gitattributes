# Canonical Git Line Endings Normalization
* text=auto eol=lf

# Source Code
*.go text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sql text eol=lf

# Shell Scripts
*.sh text eol=lf

# Binaries
*.so binary
*.tar.gz binary
*.png binary
*.jpg binary
*.ico binary

# Vendored / Compiled Assets (Excluded from GitHub Language Detection)
plugins/auto-switcher-pro/internal/web/assets/** linguist-vendored
plugins/auto-switcher-pro/web/dist/** linguist-vendored

